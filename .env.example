# Copie este arquivo para ".env" e ajuste os valores para rodar localmente.
# Em produção (Render), essas variáveis são configuradas no painel do Render,
# não neste arquivo.

# Chave secreta do Django (gere uma nova para produção)
SECRET_KEY=troque-esta-chave-em-producao-opalaverde

# True para desenvolvimento local, False em produção
DEBUG=True

# Hosts permitidos, separados por vírgula
ALLOWED_HOSTS=localhost,127.0.0.1

# String de conexão do PostgreSQL. Se deixar em branco, o projeto usa
# SQLite localmente (bom para testar rápido sem instalar Postgres).
# Exemplo Postgres local:
# DATABASE_URL=postgres://usuario:senha@localhost:5432/opalaverde
DATABASE_URL=

# CORS: em desenvolvimento pode deixar True. Em produção, prefira listar
# os domínios reais do frontend em CORS_ALLOWED_ORIGINS e colocar False aqui.
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=

CSRF_TRUSTED_ORIGINS=
